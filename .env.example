# Corsen Context — environment variables
# Copy this file to .env and fill in your values.

# --- API key ---
# Optional. Read by the TypeScript core when security.apiKey is not set in the
# configuration object: every MCP request must then carry the key in
# X-MCP-Key or Authorization: Bearer. Generate one with: openssl rand -base64 32
CORSEN_CONTEXT_API_KEY=

# --- Redis (multi-instance deployments) ---
# Not read by the packages. The core takes an injected RedisCache and
# RedisRateLimitStore (see the Upstash recipe in packages/nextjs-adapter);
# keep the connection string here for the code that builds that client.
REDIS_URL=

# --- Logging ---
# Read by the default logger: fatal, error, warn, info (default), debug, trace, silent
LOG_LEVEL=info

# --- Site ---
# Used by the examples and the CMS bridges to build their configuration. The
# packages themselves read siteUrl from the configuration object.
SITE_URL=https://yoursite.com
