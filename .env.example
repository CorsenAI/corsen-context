# Corsen Context — Environment Variables
# Copy this file to .env and fill in your values.

# --- API Key ---
# Optional. If set, all MCP requests require this key via X-MCP-Key header or Authorization: Bearer.
# Generate a strong key: openssl rand -base64 32
CORSEN_CONTEXT_API_KEY=

# --- Redis (production) ---
# Required for distributed rate limiting and caching in multi-instance deployments.
# Supports any Redis-compatible URL (Redis, Upstash, Dragonfly, KeyDB).
REDIS_URL=

# --- Logging ---
# Log level: fatal, error, warn, info (default), debug, trace, silent
LOG_LEVEL=info

# --- Site ---
# Your site URL (required in config, but can also be set via env)
SITE_URL=https://yoursite.com
