{
  "name": "@corsenai/corsen-context",
  "version": "2.0.0",
  "description": "Owner-controlled public content tools for MCP, WebMCP, llms.txt, and sitemaps",
  "author": "Corsen AI <contact@corsen.ai>",
  "license": "MIT",
  "homepage": "https://github.com/CorsenAI/corsen-context",
  "repository": {
    "type": "git",
    "url": "https://github.com/CorsenAI/corsen-context.git",
    "directory": "packages/core"
  },
  "keywords": [
    "mcp",
    "llms-txt",
    "ai",
    "context",
    "model-context-protocol",
    "sitemap",
    "wordpress",
    "nextjs",
    "corsen",
    "security",
    "redis",
    "logging",
    "json-rpc"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^5.7.0",
    "pino": "^10.3.1",
    "turndown": "^7.2.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "undici": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    }
  },
  "devDependencies": {
    "@upstash/redis": "^1.38.3",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "undici": "^7.29.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/CorsenAI/corsen-context/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  }
}
