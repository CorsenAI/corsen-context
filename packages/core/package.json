{
  "name": "@corsenai/corsen-context",
  "version": "1.1.0",
  "description": "Universal AI Context Layer — MCP Server + Enhanced llms.txt for any website",
  "author": "Corsen AI <contact@corsen.ai>",
  "license": "MIT",
  "homepage": "https://github.com/CorsenAI/corsen-context",
  "repository": {
    "type": "git",
    "url": "https://github.com/CorsenAI/corsen-context.git",
    "directory": "packages/core"
  },
  "keywords": [
    "mcp",
    "llms-txt",
    "ai",
    "context",
    "model-context-protocol",
    "sitemap",
    "wordpress",
    "nextjs",
    "corsen",
    "security",
    "redis",
    "logging",
    "json-rpc"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^4.5.0",
    "pino": "^10.3.1",
    "turndown": "^7.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/CorsenAI/corsen-context/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  }
}
