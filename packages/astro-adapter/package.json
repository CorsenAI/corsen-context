{
  "name": "@corsenai/corsen-context-astro",
  "version": "2.0.1",
  "description": "Astro adapter for owner-controlled MCP, WebMCP, llms.txt, and sitemap surfaces",
  "author": "Corsen AI <contact@corsen.ai>",
  "license": "MIT",
  "homepage": "https://github.com/CorsenAI/corsen-context",
  "repository": {
    "type": "git",
    "url": "https://github.com/CorsenAI/corsen-context.git",
    "directory": "packages/astro-adapter"
  },
  "keywords": [
    "mcp",
    "llms-txt",
    "astro",
    "ai",
    "corsen"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@corsenai/corsen-context": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/CorsenAI/corsen-context/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  }
}
