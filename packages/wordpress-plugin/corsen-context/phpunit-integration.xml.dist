<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap-integration.php"
	colors="true"
	convertDeprecationsToExceptions="false"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
>
	<testsuites>
		<testsuite name="Corsen Context WordPress Integration">
			<file>tests/WordPressIntegrationTest.php</file>
		</testsuite>
	</testsuites>
	<php>
		<const name="WP_TESTS_PHPUNIT_POLYFILLS_PATH" value="vendor/yoast/phpunit-polyfills"/>
	</php>
</phpunit>
