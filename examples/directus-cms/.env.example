SITE_URL=http://localhost:3000
DIRECTUS_URL=http://127.0.0.1:8055
# Leave empty only when the posts collection has public read access.
DIRECTUS_TOKEN=
# Required publication boundary. The API role must be allowed to read this field.
DIRECTUS_STATUS_FIELD=status
DIRECTUS_PUBLISHED_VALUE=published
# Set to 1 only for a collection whose every row is intentionally public.
DIRECTUS_PUBLIC_COLLECTION=0
HOST=127.0.0.1
# Set to 1 only when the service accepts traffic exclusively from one trusted proxy hop.
TRUST_PROXY=0
