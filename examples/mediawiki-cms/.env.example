SITE_URL=http://localhost:3000
MW_API_URL=http://127.0.0.1:8080/api.php
# Identify this deployment and include an operator contact URL or email for public wikis.
MW_USER_AGENT=Corsen-Context-Example/1.0 (https://www.example.com/contact)
# Bounded corpus, batch, and cache controls.
MW_MAX_PAGES=100
MW_BATCH_SIZE=20
MW_CACHE_TTL_MS=30000
# Set to 1 only when the service accepts traffic exclusively from one trusted proxy hop.
TRUST_PROXY=0
