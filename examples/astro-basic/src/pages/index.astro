---
import AuroraPage from '../components/AuroraPage.astro';
import { demoPages } from '../lib/provider';
const page = demoPages.find((item) => item.path === '/');
const mcpEnabled = process.env.CORSEN_CONTEXT_MCP_ENABLED !== 'false';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aurora Kits — Astro WebMCP use-case gallery</title>
    <meta name="description" content="Read-only product, support, policy, and guide workflows over four WebMCP tools." />
    {mcpEnabled && <script src="/webmcp.js" defer></script>}
    {mcpEnabled && <script src="/webmcp-status.js" defer></script>}
  </head>
  <body>{page && <AuroraPage page={page} />}</body>
</html>
