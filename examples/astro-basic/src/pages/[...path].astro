---
import AuroraPage from '../components/AuroraPage.astro';
import { demoPages } from '../lib/provider';
const page = demoPages.find((item) => item.path === Astro.url.pathname);
if (!page) Astro.response.status = 404;
const mcpEnabled = process.env.CORSEN_CONTEXT_MCP_ENABLED !== 'false';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page ? `${page.title} — Aurora Kits` : 'Page not found'}</title>
    <meta name="description" content={page?.description ?? 'Page not found'} />
    {mcpEnabled && <script src="/webmcp.js" defer></script>}
    {mcpEnabled && <script src="/webmcp-status.js" defer></script>}
  </head>
  <body>{page ? <AuroraPage page={page} /> : <main><h1>Page not found</h1><p><a href="/">Return home</a></p></main>}</body>
</html>
